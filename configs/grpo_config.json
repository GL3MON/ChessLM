{
  "model_name": "meta-llama/Llama-3.2-1B",
  "stockfish_path": "/hfcache/harissh/ChessLM/stockfish",
  "stockfish_depth": 15,
  "stockfish_threads": 1,

  "grpo": {
    "num_samples_per_prompt": 4,
    "beta": 0.1,
    "gamma": 1.0,
    "epsilon": 0.2,
    "num_epochs": 1,
    "learning_rate": 1e-6
  },

  "training": {
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "max_seq_length": 1024,
    "logging_steps": 10,
    "save_steps": 500,
    "warmup_steps": 100,
    "weight_decay": 0.01,
    "lr_scheduler_type": "cosine"
  },

  "data": {
    "dataset_path": "./splits",
    "train_split": "train",
    "val_split": "validation",
    "category_weights": {
      "FIND_NEXT_BEST_MOVE": 1.0,
      "FIND_ADVANTAGED_PLAYER": 1.0,
      "FIND_FINAL_SCORE": 0.8,
      "MLM_ON_MOVES": 1.0,
      "FIND_LAST_MOVE": 1.0,
      "SORT_FENS": 0.5
    }
  },

  "output": {
    "output_dir": "./outputs/llama-3.2-1b-rl-grpo",
    "wandb_project": "chesslm",
    "wandb_entity": ""
  }
}